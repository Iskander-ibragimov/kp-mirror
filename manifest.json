{
  "manifest_version": 3,
  "name": "Кинопоиск → kinokino.vip",
  "version": "1.0.0",
  "description": "Кнопка ▶ рядом с названием фильма на Кинопоиске: открывает этот фильм на kinokino.vip.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kinopoisk.ru/*", "https://kinopoisk.ru/*"],
      "js": ["src/url.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
